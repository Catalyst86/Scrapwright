; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Scrapwright"
config/description="A survivors-like roguelite"
run/main_scene="res://scenes/intro_video.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/game_icon.png"

[autoload]

GameState="*res://autoloads/game_state.gd"
CraftingDB="*res://autoloads/crafting_db.gd"
StageData="*res://autoloads/stage_data.gd"
OrbitalDB="*res://autoloads/orbital_db.gd"
WaveManager="*res://autoloads/wave_manager.gd"
SaveManager="*res://autoloads/save_manager.gd"
Achievements="*res://autoloads/achievements.gd"
ArmorDB="*res://autoloads/armor_db.gd"
JunkyardState="*res://autoloads/junkyard_state.gd"
CardDB="*res://autoloads/card_db.gd"
AudioManager="*res://autoloads/audio_manager.gd"
KeybindManager="*res://autoloads/keybind_manager.gd"
UpgradeDB="*res://autoloads/upgrade_db.gd"
VFXPool="*res://autoloads/vfx_pool.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=2
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://assets/default_theme.tres"

