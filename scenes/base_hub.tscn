[sub_resource type="Shader" id="glow_ring_shader"]
code = "shader_type canvas_item;
uniform vec4 glow_color : source_color = vec4(0.0, 0.85, 0.85, 0.55);
uniform float ring_radius = 0.38;
uniform float ring_width = 0.035;
uniform float glow_spread = 0.09;
void fragment() {
	vec2 uv = UV - vec2(0.5);
	float d = length(uv);
	float ring = abs(d - ring_radius);
	float alpha = smoothstep(ring_width + glow_spread, ring_width, ring);
	alpha *= (0.7 + 0.3 * sin(TIME * 2.0));
	COLOR = vec4(glow_color.rgb, alpha * glow_color.a);
}"

[sub_resource type="ShaderMaterial" id="glow_ring_mat"]
shader = SubResource("glow_ring_shader")
shader_parameter/glow_color = Color(0, 0.85, 0.85, 0.55)
shader_parameter/ring_radius = 0.38
shader_parameter/ring_width = 0.035
shader_parameter/glow_spread = 0.09

